{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "List media (CSV)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/list_media.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--format",
                "csv"
            ],
            "justMyCode": true
        },
        {
            "name": "List media for project → JSON file",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/list_media.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--project",
                "antools",
                "--format",
                "json",
                "--out",
                "${workspaceFolder}/media.json",
                "-v"
            ],
            "justMyCode": true
        },
        {
            "name": "Uploader (dry run)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/uploader.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "/Users/julius/Library/CloudStorage/SynologyDrive-Mac/animalsusingtools/added",
                "--dry-run",
                "-v",
                "--log-csv",
                "logs/upload_log.csv",
                "--skip-existing"
            ],
            "justMyCode": true
        },
        {
            "name": "Uploader (run)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/uploader.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "/Users/julius/Library/CloudStorage/SynologyDrive-Mac/animalsusingtools/added",
                "-v",
                "--log-csv",
                "logs/upload_log.csv",
                "--skip-existing"
            ],
            "justMyCode": true
        }
    ]
}
